{
  "expo": {
    "name": "FLYNT",
    "slug": "flynt-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flynt",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141414",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.threesixtyvue.flynt",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.threesixtyvue.flynt"
        ]
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "spotify"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141414",
          "image": "./assets/images/flynt-mark-light.png",
          "dark": {
            "backgroundColor": "#141414",
            "image": "./assets/images/flynt-mark-light.png"
          },
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-notifications",
      [
        "flynt-google-auth",
        {
          "iosUrlScheme": "com.googleusercontent.apps.404535560676-jpvemrs30oki2pt6vdgfvh5s0854r20j"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.threesixtyvue.flynt.widget",
          "groupIdentifier": "group.com.threesixtyvue.flynt",
          "widgets": [
            {
              "name": "FlyntTodayWidget",
              "displayName": "Today",
              "description": "See today's FLYNT workout and set progress.",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ]
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4d50525-4168-4df7-8c28-4fdd19a794ea"
      }
    },
    "owner": "tsv-ai"
  }
}
